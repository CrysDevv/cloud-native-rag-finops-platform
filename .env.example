# ============================================================
# cloud-native-rag-finops-platform — Variables de entorno
# Copiar a .env:  cp .env.example .env
# ============================================================

# --- General ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL 16 + pgvector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_finops
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=cambiar_password_local_seguro
DATABASE_URL=postgresql+asyncpg://rag_admin:cambiar_password_local_seguro@postgres:5432/rag_finops

# --- Redis 7 (caché semántica y control de cuota) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# --- AWS / LocalStack (costo $0 USD) ---
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
LOCALSTACK_ENDPOINT_HOST=http://localhost:4566

# --- Recursos AWS emulados ---
S3_BUCKET_DOCUMENTOS=rag-documentos-local
SQS_QUEUE_INGESTA=rag-ingesta-queue
SQS_QUEUE_DLQ=rag-ingesta-dlq
SQS_MAX_RECEIVE_COUNT=3
SECRETS_DB_NAME=rag/database
SECRETS_APP_NAME=rag/app

# --- IA Soberana (embeddings locales deterministas, sin API keys de pago) ---
EMBEDDING_PROVIDER=local-deterministic
EMBEDDING_DIMENSIONS=384
LLM_PROVIDER=local-extractive
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- PII Guardrail ---
PII_ANONYMIZE_ENABLED=true
PII_RUT_MASK=[RUT_ANONIMIZADO]

# --- FinOps ---
FINOPS_BUDGET_USD=0
FINOPS_ALERT_THRESHOLD_PCT=80
REDIS_QUOTA_REQUESTS_PER_MINUTE=60

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=api-fastapi
CORRELATION_ID_HEADER=X-Correlation-ID

# --- Puertos expuestos en host ---
API_PORT=8000
FRONTEND_PORT=5173
