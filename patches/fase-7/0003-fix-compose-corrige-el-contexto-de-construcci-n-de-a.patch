---
 docker-compose.build.yml | 11 +++++++++++
 docker-compose.fixes.yml |  6 ++++++
 2 files changed, 17 insertions(+)
 create mode 100644 docker-compose.build.yml
 create mode 100644 docker-compose.fixes.yml

diff --git a/docker-compose.build.yml b/docker-compose.build.yml
new file mode 100644
index 0000000..c8a0a7a
--- /dev/null
+++ b/docker-compose.build.yml
@@ -0,0 +1,11 @@
+# Corrige el contexto de construcción: el Dockerfile copia services/api-fastapi desde la raíz del repositorio.
+# api y worker comparten la misma imagen base de código (python -m worker para el worker).
+services:
+  api:
+    build:
+      context: .
+      dockerfile: docker/Dockerfile.python312
+  worker:
+    build:
+      context: .
+      dockerfile: docker/Dockerfile.python312
diff --git a/docker-compose.fixes.yml b/docker-compose.fixes.yml
new file mode 100644
index 0000000..30b6b23
--- /dev/null
+++ b/docker-compose.fixes.yml
@@ -0,0 +1,6 @@
+# Redis con cap_drop: ALL no puede ejecutar el chown de su entrypoint (CAP_CHOWN).
+# Se arranca directamente como el usuario redis (uid 999, gid 1000 en redis:7-alpine) para omitirlo.
+# No se redefine tmpfs: las listas se concatenan al fusionar y duplicarían el montaje de /data.
+services:
+  redis:
+    user: "999:1000"
-- 
