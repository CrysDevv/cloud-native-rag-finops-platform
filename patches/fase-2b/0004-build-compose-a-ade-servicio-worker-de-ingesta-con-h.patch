---
 docker-compose.worker.yml | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)
 create mode 100644 docker-compose.worker.yml

diff --git a/docker-compose.worker.yml b/docker-compose.worker.yml
new file mode 100644
index 0000000..3f60464
--- /dev/null
+++ b/docker-compose.worker.yml
@@ -0,0 +1,19 @@
+# Uso: docker compose -f docker-compose.yml -f docker-compose.worker.yml up -d --build worker
+# Requiere Docker Compose >= 2.24 (etiqueta !reset). Hereda imagen, entorno y dependencias del servicio "api".
+services:
+  worker:
+    extends:
+      file: docker-compose.yml
+      service: api
+    container_name: rag-worker-ingesta
+    command: ["python", "-m", "worker"]
+    ports: !reset []
+    expose:
+      - "9100"
+    stop_grace_period: 60s
+    healthcheck:
+      test: ["CMD", "python", "-c", "import os,sys,time; sys.exit(0 if time.time()-os.path.getmtime('/tmp/worker_heartbeat')<90 else 1)"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 20s
